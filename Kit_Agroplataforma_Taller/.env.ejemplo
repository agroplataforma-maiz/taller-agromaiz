# Copia este archivo como .env y ajusta los valores.
DOMINIO=taller.agromaiz.mx
ORGANIZACION=UICSLP – Capacitación
# campus = elementos del campus (árboles, plantas, áreas verdes)   |   maiz = mazorcas y parcelas de maíz
PLANTILLA=campus
N_EQUIPOS=12
# Coordenadas de la sede (centro del mapa). Tómalas de Google Maps: clic derecho sobre el lugar.
SEDE_LAT=22.1498
SEDE_LON=-100.9792
# Código del usuario "admin" (pon uno largo y no lo compartas)
ADMIN_CODIGO=cambia-este-codigo
MAX_FOTO_MB=8
